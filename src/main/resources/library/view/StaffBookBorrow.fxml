<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" styleClass="background" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.view.StaffBookBorrowController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label prefHeight="27.0" prefWidth="156.0" style="-fx-font-family: Arial; -fx-font-size: 20; -fx-font-weight: bold;" text="Staff Details:" VBox.vgrow="ALWAYS">
               <font>
                  <Font name="System Bold Italic" size="18.0" />
               </font>
               <padding>
                  <Insets bottom="-10.0" />
               </padding>
            </Label>
            <HBox VBox.vgrow="ALWAYS">
               <children>
                  <GridPane maxHeight="300.0" prefHeight="189.0" prefWidth="408.0" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="279.33331298828125" minWidth="10.0" prefWidth="186.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="434.66668701171875" minWidth="10.0" prefWidth="374.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label prefHeight="21.0" prefWidth="301.0" text="Staff ID   " />
                        <Label prefHeight="21.0" prefWidth="315.0" text="Staff Name  " GridPane.rowIndex="1" />
                        <Label prefHeight="21.0" prefWidth="320.0" text="Mobile Number  " GridPane.rowIndex="3" />
                        <Label prefHeight="21.0" prefWidth="330.0" text="Email Address  " GridPane.rowIndex="4" />
                        <Label prefHeight="21.0" prefWidth="369.0" text="Entry Date  " GridPane.rowIndex="6" />
                        <Label prefHeight="21.0" prefWidth="396.0" text="Date of Birth" GridPane.rowIndex="2" />
                        <Label prefHeight="21.0" prefWidth="339.0" text="Nationality  " GridPane.rowIndex="5" />
                        <Label fx:id="staffIdLabel" text="Label" GridPane.columnIndex="1" />
                        <Label fx:id="staffNameLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label fx:id="dobLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label fx:id="mobileLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label fx:id="emailLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <Label fx:id="nationalityLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        <Label fx:id="entryDateLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                     </children>
                  </GridPane>
               </children>
            </HBox>
            <TableView fx:id="bookBorrowedTable" prefHeight="200.0" prefWidth="200.0" style="-fx-border-color: RGB(108,108,108); -fx-border-width: 2;" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="bookIdColumn" prefWidth="70.8052978515625" text="Book ID" />
                <TableColumn fx:id="bookTitleColumn" prefWidth="108.5462646484375" text="Book Title" />
                  <TableColumn fx:id="authorColumn" prefWidth="84.56640625" text="Author" />
                  <TableColumn fx:id="borrowDateColumn" prefWidth="104.17095947265625" text="Borrow Date" />
                  <TableColumn fx:id="dueDateColumn" prefWidth="103.0556640625" text="Due Date" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox VBox.vgrow="SOMETIMES">
               <children>
                  <RadioButton fx:id="personIdButton" mnemonicParsing="false" prefHeight="31.0" prefWidth="106.0" selected="true" text="Person ID" HBox.hgrow="ALWAYS">
                     <toggleGroup>
                        <ToggleGroup fx:id="ID" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="bookIdButton" mnemonicParsing="false" prefHeight="32.0" prefWidth="89.0" text="Book ID" toggleGroup="$ID" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="idTextField" onKeyPressed="#selectPersonBook" prefHeight="32.0" prefWidth="346.0" promptText="E.g. S09011111 or BF000001H" HBox.hgrow="SOMETIMES">
                     <font>
                        <Font name="Comic Sans MS" size="14.666666984558105" />
                     </font>
                  </TextField>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
