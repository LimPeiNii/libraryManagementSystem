<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" styleClass="background" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.view.BookListController">
   <children>
      <ChoiceBox fx:id="genreChoiceBox" layoutX="23.0" layoutY="25.0" prefWidth="150.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
      <TableView fx:id="bookTable" layoutX="23.0" layoutY="72.0" prefHeight="359.0" prefWidth="560.0" AnchorPane.bottomAnchor="71.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="70.0">
        <columns>
          <TableColumn fx:id="bookIDcolumn" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="bookTitleColumn" prefWidth="75.0" text="Title" />
            <TableColumn fx:id="authorColumn" prefWidth="75.0" text="Author" />
            <TableColumn fx:id="languageColumn" prefWidth="75.0" text="Language" />
            <TableColumn fx:id="locationColumn" prefWidth="75.0" text="Location" />
            <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <TextField fx:id="filterBookTextField" layoutX="185.0" layoutY="20.0" prefHeight="31.0" prefWidth="321.0" promptText="Book Title" AnchorPane.leftAnchor="185.0" AnchorPane.rightAnchor="94.0" AnchorPane.topAnchor="20.0" />
      <Button defaultButton="true" layoutX="516.0" layoutY="20.0" mnemonicParsing="false" onAction="#filter" prefHeight="32.0" prefWidth="60.0" text="Filter" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />
      <HBox layoutX="343.0" layoutY="447.0" spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0">
         <children>
            <Button fx:id="newButton" mnemonicParsing="false" onAction="#addNewBook" prefHeight="35.0" prefWidth="78.0" text="New" />
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#editBook" prefHeight="35.0" prefWidth="78.0" text="Edit" />
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteBook" prefHeight="35.0" prefWidth="78.0" text="Delete" />
         </children>
      </HBox>
   </children>
</AnchorPane>
