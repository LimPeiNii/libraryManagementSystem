<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" styleClass="background" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.view.BookReturnController">
   <children>
      <HBox layoutX="20.0" layoutY="448.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
         <children>
            <RadioButton disable="true" mnemonicParsing="false" prefHeight="31.0" prefWidth="106.0" selected="true" text="Person ID" HBox.hgrow="ALWAYS">
               <toggleGroup>
                  <ToggleGroup fx:id="ID" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="bookIdButton" mnemonicParsing="false" prefHeight="32.0" prefWidth="89.0" selected="true" text="Book ID" toggleGroup="$ID" HBox.hgrow="ALWAYS" />
            <TextField fx:id="idTextField" onKeyPressed="#returnBook" prefHeight="32.0" prefWidth="346.0" promptText="E.g. BF000001H" HBox.hgrow="SOMETIMES">
               <font>
                  <Font name="Comic Sans MS" size="14.666666984558105" />
               </font>
            </TextField>
         </children>
      </HBox>
      <GridPane layoutX="48.0" layoutY="49.0" prefHeight="207.0" prefWidth="454.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Book ID:" />
            <Label text="Book Title: " GridPane.rowIndex="1" />
            <Label text="Due Date: " GridPane.rowIndex="2" />
            <Label text="Overdue Days: " GridPane.rowIndex="3" />
            <Label text="Overdue Total Fee:" GridPane.rowIndex="4" />
            <Label fx:id="bookIdLabel" text="Label" GridPane.columnIndex="1" />
            <Label fx:id="bookTitleLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label fx:id="dueDateLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label fx:id="overdueDaysLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label fx:id="totalFeeLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
   </children>
</AnchorPane>
